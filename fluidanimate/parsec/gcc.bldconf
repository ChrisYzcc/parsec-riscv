#!/bin/bash

# gcc.bldconf - configuration file for PARSEC

# Default parallelization model is pthreads
source ${PARSECDIR}/pkgs/apps/fluidanimate/parsec/gcc-pthreads.bldconf

if [ "${RISCV_CROSS_COMPILE}" = "1" ]; then
    # Compilers and preprocessors
    export CC="${CC_HOME}/bin/${CROSS_COMPILATION_PREFIX}gcc"
    export CXX="${CC_HOME}/bin/${CROSS_COMPILATION_PREFIX}g++"
    export CPP="${CC_HOME}/bin/${CROSS_COMPILATION_PREFIX}cpp"
    export CXXCPP=""

    # GNU Binutils
    export LD="${BINUTIL_HOME}/bin/${CROSS_COMPILATION_PREFIX}ld"
    export AS="${BINUTIL_HOME}/bin/${CROSS_COMPILATION_PREFIX}as"
    export AR="${BINUTIL_HOME}/bin/${CROSS_COMPILATION_PREFIX}ar"
    export RANLIB="${BINUTIL_HOME}/bin/${CROSS_COMPILATION_PREFIX}ranlib"
    export STRIP="${BINUTIL_HOME}/bin/${CROSS_COMPILATION_PREFIX}strip"
fi